#include <limits.h>
#include <stdlib.h>

int divide(int dividend, int divisor) {
    // Handle the specific overflow corner case
    if (dividend == INT_MIN && divisor == -1) {
        return INT_MAX;
    }
    
    // Determine the sign of the final quotient
    int sign = ((dividend > 0) == (divisor > 0)) ? 1 : -1;
    
    // Convert to positive values using 64-bit unsigned/long long to avoid overflows
    long long absDividend = llabs((long long)dividend);
    long long absDivisor = llabs((long long)divisor);
    
    long long quotient = 0;
    
    // Exponential subtraction using bitwise shifting on positive numbers
    while (absDividend >= absDivisor) {
        long long tempDivisor = absDivisor;
        long long multiple = 1;
        
        // Double the divisor safely using left shifts on positive values
        while (absDividend >= (tempDivisor << 1)) {
            tempDivisor <<= 1;
            multiple <<= 1;
        }
        
        // Subtract the largest found power-of-two multiple
        absDividend -= tempDivisor;
        quotient += multiple;
    }
    
    // Apply the sign to the final output
    long long finalResult = (sign == 1) ? quotient : -quotient;
    
    // Boundary check before returning as a 32-bit signed int
    if (finalResult > INT_MAX) return INT_MAX;
    if (finalResult < INT_MIN) return INT_MIN;
    
    return (int)finalResult;
}
