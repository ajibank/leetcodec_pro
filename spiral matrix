#include <stdio.h>
#include <stdlib.h>

/**
 * Note: The returned array must be malloced, assume caller calls free().
 */
int* spiralOrder(int** matrix, int matrixSize, int* matrixColSize, int* returnSize) {
    if (matrixSize == 0 || matrixColSize[0] == 0) {
        *returnSize = 0;
        return NULL;
    }

    int rows = matrixSize;
    int cols = matrixColSize[0];
    int totalElements = rows * cols;
    
    // Allocate memory for the output result array
    int* result = (int*)malloc(totalElements * sizeof(int));
    *returnSize = totalElements;

    int top = 0, bottom = rows - 1;
    int left = 0, right = cols - 1;
    int k = 0; // Pointer index for result array

    while (top <= bottom && left <= right) {
        // 1. Move Right across the top row
        for (int i = left; i <= right; i++) {
            result[k++] = matrix[top][i];
        }
        top++;

        // 2. Move Down along the right column
        for (int i = top; i <= bottom; i++) {
            result[k++] = matrix[i][right];
        }
        right--;

        // 3. Move Left across the bottom row (if rows remain)
        if (top <= bottom) {
            for (int i = right; i >= left; i--) {
                result[k++] = matrix[bottom][i];
            }
            bottom--;
        }

        // 4. Move Up along the left column (if columns remain)
        if (left <= right) {
            for (int i = bottom; i >= top; i--) {
                result[k++] = matrix[i][left];
            }
            left++;
        }
    }

    return result;
}
