#include <stdio.h>
#include <stdlib.h>
#include <string.h>

// 1. Lexicographically non-decreasing order
int lexicographic_sort(const char* a, const char* b) {
    return strcmp(a, b);
}

// 2. Lexicographically non-increasing order
int lexicographic_sort_reverse(const char* a, const char* b) {
    return strcmp(b, a);
}

// Helper function to count distinct characters in a string
int count_distinct_chars(const char* str) {
    int hash[26] = {0};
    int distinct_count = 0;
    while (*str) {
        if (hash[*str - 'a'] == 0) {
            hash[*str - 'a'] = 1;
            distinct_count++;
        }
        str++;
    }
    return distinct_count;
}

// 3. Non-decreasing order of distinct characters, secondary lexicographic order
int sort_by_number_of_distinct_characters(const char* a, const char* b) {
    int count_a = count_distinct_chars(a);
    int count_b = count_distinct_chars(b);
    if (count_a == count_b) {
        return strcmp(a, b);
    }
    return count_a - count_b;
}

// 4. Non-decreasing order of length, secondary lexicographic order
int sort_by_length(const char* a, const char* b) {
    int len_a = strlen(a);
    int len_b = strlen(b);
    if (len_a == len_b) {
        return strcmp(a, b);
    }
    return len_a - len_b;
}

// Generic string sorting function using Bubble Sort
void string_sort(char** arr, const int len, int (*cmp_func)(const char* a, const char* b)) {
    for (int i = 0; i < len - 1; i++) {
        for (int j = 0; j < len - i - 1; j++) {
            // If cmp_func returns a value greater than 0, it means order is wrong -> swap
            if (cmp_func(arr[j], arr[j + 1]) > 0) {
                char* temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
            }
        }
    }
}
