#include <stdio.h>

int searchInsert(int* nums, int numsSize, int target) {
    int left = 0;
    int right = numsSize - 1;
    
    while (left <= right) {
        int mid = left + (right - left) / 2;
        
        // If target is found, return its index immediately
        if (nums[mid] == target) {
            return mid;
        }
        // If target is larger, narrow search to the right half
        else if (nums[mid] < target) {
            left = mid + 1;
        }
        // If target is smaller, narrow search to the left half
        else {
            right = mid - 1;
        }
    }
    
    // If not found, 'left' points to the correct insertion index
    return left;
}
