#include <stdio.h>

int removeDuplicates(int* nums, int numsSize) {
    // If the array is empty, there are 0 unique elements
    if (numsSize == 0) {
        return 0;
    }
    
    // The first element is always unique, so we start writing from index 1
    int k = 1;
    
    // Iterate through the array starting from the second element
    for (int i = 1; i < numsSize; i++) {
        // If the current element is different from the previous one, it's unique
        if (nums[i] != nums[i - 1]) {
            nums[k] = nums[i]; // Move the unique element forward
            k++;               // Increment the count of unique elements
        }
    }
    
    // k represents the total number of unique elements
    return k;
}
