#include <stdio.h>

int removeElement(int* nums, int numsSize, int val) {
    // Pointer 'k' keeps track of where the next non-val element should be placed
    int k = 0;
    
    // Iterate through the entire array
    for (int i = 0; i < numsSize; i++) {
        // If the current element is not equal to 'val'
        if (nums[i] != val) {
            nums[k] = nums[i]; // Copy the valid element forward
            k++;               // Increment our valid element count
        }
    }
    
    // k represents the total number of elements that are not equal to 'val'
    return k;
}
