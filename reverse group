#include <stdio.h>
#include <stdlib.h>

/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     struct ListNode *next;
 * };
 */

struct ListNode* reverseKGroup(struct ListNode* head, int k) {
    if (head == NULL || k == 1) return head;
    
    // Create a stack-allocated dummy node to anchor the list
    struct ListNode dummy;
    dummy.next = head;
    
    struct ListNode* groupPrev = &dummy;
    
    while (1) {
        // Find the k-th node from groupPrev
        struct ListNode* kth = groupPrev;
        for (int i = 0; i < k; i++) {
            kth = kth->next;
            // If there are fewer than k nodes left, we are done
            if (kth == NULL) {
                return dummy.next;
            }
        }
        
        // Track the boundary nodes of the next group
        struct ListNode* groupNext = kth->next;
        
        // Reverse the current group of k nodes
        struct ListNode* prev = groupNext; // Start with connection to the next section
        struct ListNode* curr = groupPrev->next;
        struct ListNode* firstNodeOfGroup = curr; // This will become the tail of the reversed group
        
        while (curr != groupNext) {
            struct ListNode* nextTmp = curr->next;
            curr->next = prev;
            prev = curr;
            curr = nextTmp;
        }
        
        // Link the previous section's tail to the new head of the reversed group
        groupPrev->next = kth;
        
        // Move groupPrev to the tail of the newly reversed group
        groupPrev = firstNodeOfGroup;
    }
}
