// Helper function to swap two integers using pointers
void swap(int* a, int* b) {
    int temp = *a;
    *a = *b;
    *b = temp;
}

// Helper function to reverse a subarray segment in-place
void reverse(int* nums, int start, int end) {
    while (start < end) {
        swap(&nums[start], &nums[end]);
        start++;
        end--;
    }
}

void nextPermutation(int* nums, int numsSize) {
    if (numsSize <= 1) return;
    
    // Step 1: Find the first decreasing element from the right (the pivot)
    int i = numsSize - 2;
    while (i >= 0 && nums[i] >= nums[i + 1]) {
        i--;
    }
    
    // Step 2: If a valid pivot index was found
    if (i >= 0) {
        // Find the first element larger than nums[i] from the right (the successor)
        int j = numsSize - 1;
        while (nums[j] <= nums[i]) {
            j--;
        }
        // Swap the pivot and its successor
        swap(&nums[i], &nums[j]);
    }
    
    // Step 3: Reverse the entire suffix following the pivot index 'i'
    reverse(nums, i + 1, numsSize - 1);
}
